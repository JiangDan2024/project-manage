<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.plm.project.dao.MenuDao">

    <resultMap type="com.plm.project.entity.Menu" id="MenuMap">
        <result property="menuId" column="menu_id" jdbcType="INTEGER"/>
        <result property="menuName" column="menu_name" jdbcType="VARCHAR"/>
        <result property="parentId" column="parent_id" jdbcType="INTEGER"/>
        <result property="orderNum" column="order_num" jdbcType="INTEGER"/>
        <result property="path" column="path" jdbcType="VARCHAR"/>
        <result property="menuType" column="menu_type" jdbcType="VARCHAR"/>
        <result property="visible" column="visible" jdbcType="VARCHAR"/>
        <result property="perms" column="perms" jdbcType="VARCHAR"/>
        <result property="icon" column="icon" jdbcType="VARCHAR"/>
        <result property="createBy" column="create_by" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateBy" column="update_by" jdbcType="VARCHAR"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="remark" column="remark" jdbcType="VARCHAR"/>
    </resultMap>
    <select id="selectMenuPermsByRoleId" resultType="java.lang.String">
        select m.perms from `project-manager`.sys_menu m
        left join `project-manager`.sys_role_menu srm on m.menu_id = srm.menu_id
        where role_id = #{roleId}
    </select>
    <select id="selectMenusByUserId" resultType="com.plm.project.entity.Menu">
        select
            m.menu_id, menu_name, parent_id, order_num, path, menu_type, visible, perms, icon,is_frame,status,route_name
        from `project-manager`.sys_menu m
        left join `project-manager`.sys_role_menu rm on m.menu_id = rm.menu_id
        left join `project-manager`.sys_user_role ur on ur.role_id = rm.role_id
        where ur.user_id = #{userId}
    </select>

</mapper>

